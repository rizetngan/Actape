<Window x:Class="Actape.Windows.MainWindow" x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actape" Icon="Resources/Actape.ico" Width="1110" Height="740"
        MinWidth="930" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        Background="{StaticResource CanvasBrush}">
    <Window.Resources>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8290A3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBoxItem" x:Key="MacroItemStyle">
            <Setter Property="Margin" Value="9,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="11" Padding="14,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#E4EBFA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#CAD7F2"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem" x:Key="StepItemStyle">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="StepFrame" Background="#F6F8FC" CornerRadius="9" Padding="13,11" BorderBrush="#EDF1F6" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="StepFrame" Property="Background" Value="#E9F0FE"/>
                                <Setter TargetName="StepFrame" Property="BorderBrush" Value="#90AFE9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepFrame" Property="BorderBrush" Value="#B7C8E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#F1F5FA" BorderBrush="#E2E9F2" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,13">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,19">
                        <Border Background="#3667DC" CornerRadius="9" Width="37" Height="37" Margin="0,0,11,0">
                            <TextBlock Text="◉" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Actape" FontSize="19" FontWeight="Bold" Foreground="#263650"/>
                            <TextBlock Text="鼠标与键盘" FontSize="11" Foreground="#8896AA"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="＋  新建宏" Style="{StaticResource PrimaryButton}" Click="NewMacro_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,19">
                    <Border BorderBrush="#DDE5EF" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                    <CheckBox x:Name="EnableCheck" IsChecked="True" Checked="EnableCheck_Changed" Unchecked="EnableCheck_Changed"
                              Content="启用宏" FontSize="13" Foreground="#354862" VerticalAlignment="Center"/>
                    <TextBlock Text="关闭窗口后仍在托盘中运行" Foreground="#94A1B2" FontSize="11" Margin="0,7,0,13"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导入" Style="{StaticResource QuietButton}" Margin="0,0,7,0" Click="Import_Click"/>
                        <Button Content="导出" Style="{StaticResource QuietButton}" Click="Export_Click"/>
                        <TextBlock x:Name="MacroCountLabel" Foreground="#94A1B2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="MacroList" BorderThickness="0" Background="Transparent" Margin="5,0,5,0"
                         ItemsSource="{Binding Macros}"
                         ItemContainerStyle="{StaticResource MacroItemStyle}"
                         SelectionChanged="MacroList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#24324A" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TriggerDisplay}" Foreground="#7687A0" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StepCount, StringFormat={}{0} 步}" Foreground="#9AA6B8" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right work area -->
        <Grid Grid.Column="1" Margin="26,20,26,17">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="宏名称" Style="{StaticResource SectionCaption}"/>
                    <TextBox x:Name="MacroNameBox"
                             FontSize="21" FontWeight="SemiBold" Foreground="#21304A"
                             Background="Transparent" BorderThickness="0" Padding="0,0,0,0"
                             Text="{Binding SelectedMacro.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="RecordButton" Content="●  开始录制" Click="RecordButton_Click"
                            Style="{StaticResource QuietButton}" Margin="0,0,8,0"
                            ToolTip="开始录制 / F6"/>
                    <Button x:Name="PlayButton" Content="▶  测试执行" Click="PlayButton_Click"
                            Style="{StaticResource PrimaryButton}" ToolTip="执行宏 / F7"/>
                    <Button Content="⋯" Click="MoreButton_Click" FontSize="21" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                            Width="42" Padding="0,5"/>
                </StackPanel>
            </Grid>

            <!-- Trigger and playback settings -->
            <Border Grid.Row="1" BorderBrush="#E3EAF4" BorderThickness="1" Background="White" CornerRadius="13" Padding="17,15" Margin="0,0,0,19">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="鼠标侧键" Style="{StaticResource SectionCaption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BoundButtonLabel" Text="未绑定" FontSize="14" FontWeight="Medium" Foreground="#2B3F5B" VerticalAlignment="Center"/>
                                <Button x:Name="BindButton" Content="绑定侧键…" Click="BindButton_Click"
                                        Style="{StaticResource QuietButton}" Margin="13,0,0,0" Padding="13,7"/>
                                <Button x:Name="ClearBindButton" Content="清除" Click="ClearBindButton_Click"
                                        Style="{StaticResource QuietButton}" Margin="7,0,0,0" Padding="11,7"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="178">
                            <TextBlock Text="触发方式" Style="{StaticResource SectionCaption}"/>
                            <ComboBox x:Name="TriggerModePicker" SelectionChanged="TriggerModePicker_Changed" Height="34">
                                <ComboBoxItem Content="单击触发"/>
                                <ComboBoxItem Content="按住触发"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" Margin="0,14,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" x:Name="RepeatSettings">
                            <TextBlock Text="执行次数" Style="{StaticResource SectionCaption}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="RepeatTextBox" Width="65" Height="32" Text="{Binding SelectedMacro.RepeatCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="次" Style="{StaticResource FieldLabel}" Margin="7,0,15,0"/>
                                <CheckBox x:Name="InfiniteCheck" Content="无限循环" VerticalAlignment="Center"
                                          IsChecked="{Binding SelectedMacro.InfiniteLoop, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="执行速度" Style="{StaticResource SectionCaption}"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="4" TickFrequency="0.1" Width="163"
                                        VerticalAlignment="Center" Value="{Binding SelectedMacro.Speed, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding SelectedMacro.Speed, StringFormat={}{0:F1}×}" VerticalAlignment="Center"
                                           FontSize="12" Foreground="#52657F" Width="53" Margin="13,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HoldHint" Text="按住侧键后自动循环整个宏，松开立即停止。"
                               FontSize="12" Foreground="#687D9A" Margin="0,11,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Step list + editor -->
            <Grid Grid.Row="2" MinHeight="150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="235"/>
                    <ColumnDefinition Width="255"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="操作步骤" FontSize="15" FontWeight="SemiBold" Foreground="#273752" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CaptureKeyboardCheck" Grid.Column="1" Content="录制键盘" FontSize="12"
                                  Foreground="#64748B" VerticalAlignment="Center"
                                  ToolTip="录制键盘输入时启用；默认关闭以避免误录敏感文字"/>
                    </Grid>
                    <ListBox x:Name="StepList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding SelectedMacro.Steps}" SelectionChanged="StepList_SelectionChanged"
                             ItemContainerStyle="{StaticResource StepItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding DelayMs, StringFormat={}{0} ms}" DockPanel.Dock="Right"
                                               Foreground="#94A3B8" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#3B4C65"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,11,0,0">
                        <Button x:Name="AddStepButton" Click="AddStep_Click" Content="＋  添加步骤"
                                Style="{StaticResource QuietButton}"/>
                        <Button Content="↑" Click="MoveStepUp_Click" Style="{StaticResource QuietButton}"
                                Padding="12,9" Margin="7,0,0,0" ToolTip="上移步骤"/>
                        <Button Content="↓" Click="MoveStepDown_Click" Style="{StaticResource QuietButton}"
                                Padding="12,9" Margin="6,0,0,0" ToolTip="下移步骤"/>
                        <Button Content="删除" Click="DeleteStep_Click" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="White" BorderBrush="#E3EAF4" BorderThickness="1" CornerRadius="13" Padding="13">
                    <Grid>
                        <TextBlock x:Name="NoStepMessage" Text="选中步骤后编辑" Foreground="#9EAABD"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"/>
                        <ScrollViewer x:Name="StepEditorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="编辑步骤" FontSize="14" FontWeight="SemiBold" Foreground="#273752" Margin="0,0,0,15"/>
                                <StackPanel x:Name="KindPickerPanel" Margin="0,0,0,12">
                                    <TextBlock Text="操作类型" Style="{StaticResource SectionCaption}"/>
                                    <ComboBox x:Name="StepKindCombo" DisplayMemberPath="Name" SelectedValuePath="Value"
                                              ItemsSource="{Binding StepKindOptions}"
                                              SelectedValue="{Binding SelectedStep.Kind, Mode=TwoWay}"
                                              SelectionChanged="StepKindCombo_Changed"/>
                                </StackPanel>
                                <TextBlock Text="执行前等待（毫秒）" Style="{StaticResource SectionCaption}"/>
                                <TextBox Text="{Binding SelectedStep.DelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12"/>
                                <StackPanel x:Name="MouseButtonEditor">
                                    <TextBlock Text="鼠标按键" Style="{StaticResource SectionCaption}"/>
                                    <ComboBox DisplayMemberPath="Name" SelectedValuePath="Value"
                                              ItemsSource="{Binding MouseButtonOptions}"
                                              SelectedValue="{Binding SelectedStep.Button, Mode=TwoWay}"
                                              Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel x:Name="CoordinatesEditor">
                                    <TextBlock Text="点击坐标" Style="{StaticResource SectionCaption}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBox Width="90" Text="{Binding SelectedStep.X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBox Width="90" Margin="8,0,0,0" Text="{Binding SelectedStep.Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="DragEditor">
                                    <TextBlock Text="拖动终点坐标" Style="{StaticResource SectionCaption}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBox Width="90" Text="{Binding SelectedStep.EndX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBox Width="90" Margin="8,0,0,0" Text="{Binding SelectedStep.EndY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ClickCountEditor">
                                    <TextBlock Text="点击次数" Style="{StaticResource SectionCaption}"/>
                                    <TextBox Text="{Binding SelectedStep.ClickCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel x:Name="KeyEditor">
                                    <TextBlock Text="按键代码" Style="{StaticResource SectionCaption}"/>
                                    <TextBox Text="{Binding SelectedStep.KeyCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel x:Name="KeyComboEditor" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedStep.CoordinateSummary}" FontSize="11" Foreground="#687D9A" Margin="0,0,0,12"/>
                                    <TextBlock Text="按键组合" Style="{StaticResource SectionCaption}"/>
                                    <TextBlock Text="{Binding SelectedStep.KeyDisplay}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#273752" Margin="0,0,0,8"/>
                                    <Button x:Name="CaptureKeyButton" Content="录入按键" Click="CaptureKeyButton_Click"
                                            Style="{StaticResource QuietButton}" Margin="0,0,0,5"/>
                                </StackPanel>
                                <StackPanel x:Name="TextEditor">
                                    <TextBlock Text="输入文字" Style="{StaticResource SectionCaption}"/>
                                    <TextBox Text="{Binding SelectedStep.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel x:Name="ScrollEditor">
                                    <TextBlock Text="滚动量（正负值）" Style="{StaticResource SectionCaption}"/>
                                    <TextBox Text="{Binding SelectedStep.ScrollDelta, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,9"/>
                                    <CheckBox Content="横向滚动" IsChecked="{Binding SelectedStep.HorizontalScroll, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,13,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#8390A3" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="F6 录制  ·  F7 执行" FontSize="11" Foreground="#A5AFBD"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
